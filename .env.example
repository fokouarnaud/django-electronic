# Copy to .env (git-ignored) and adjust:   cp .env.example .env
# Read by config/settings/base.py through django-environ. Real environment variables win.
# On PythonAnywhere, keep this file in the project root with `chmod 600 .env`.

# --- Required in production --------------------------------------------------
# Django refuses to start in production without a real key (and rejects "django-insecure-*").
# Generate one (50 characters):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# --- Production, optional ----------------------------------------------------
# Extra allowed hosts, comma separated. localhost, 127.0.0.1 and .pythonanywhere.com are
# always allowed; add your own domain here if you have one.
# DJANGO_ALLOWED_HOSTS=labo.example.org,www.labo.example.org

# Redirect HTTP -> HTTPS in Django. Not needed if PythonAnywhere's "Force HTTPS" is on.
# DJANGO_SSL_REDIRECT=1

# HTTP Strict Transport Security, in seconds. Sticky in browsers: enable only once HTTPS works.
# DJANGO_HSTS_SECONDS=31536000

# --- Advanced ----------------------------------------------------------------
# Load a different env file instead of ./.env (used by the test-suite).
# DJANGO_ENV_FILE=/path/to/other.env

# NOT set here: DJANGO_SETTINGS_MODULE.
#   local dev  -> manage.py defaults to config.settings.development
#   production -> the WSGI file sets config.settings.production
